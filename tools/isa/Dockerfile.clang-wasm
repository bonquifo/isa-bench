# clang and lld for every real target, compiled to WebAssembly, so the app
# can compile a user's C program itself -- offline, with no Docker and no
# native toolchain on the user's machine.
#
#   docker build -f tools/isa/Dockerfile.clang-wasm -t isa-bench/clang-wasm:23.1.0 tools/isa
#
# It is the same LLVM release every fixture was compiled with, 23.1.0, from
# the same checksummed source tarball, so a program compiled in the app and
# one compiled by the fixture builder get the same bytes -- which the test
# suite checks. Two things differ from a native build, and neither touches
# code generation:
#
#   - One patch, from YoWASP (https://yowasp.org), which puts WASI-specific
#     conditionals around the POSIX features WebAssembly lacks -- signals,
#     processes, memory mapping. It is YoWASP's commit 97196c8e for LLVM
#     22.1.0, ported to 23.1.0 and pinned by checksum. The port moved one
#     hunk's context, gave two signal-handling stubs 23.1.0's signatures,
#     stubbed the stack-trace hook 23.1.0 calls from more places, guarded
#     the one new use of signals (in clang's driver), and supplied a no-op
#     posix_madvise, which wasi-libc declares but does not implement. It
#     also fixes one bug of the original: closing a file reported whatever
#     errno an earlier, unrelated call had left, so every object file clang
#     wrote was "an IO failure".
#   - Only the seven targets the app compiles for are built, and only the
#     multi-call `llvm` binary that holds clang, lld and llvm-ar.
#
# One thing is added: the release's commit, which a build from the source
# tarball does not know. clang and lld write it into every ELF's .comment
# section, so without it the app's binaries differ from the fixtures in
# that string and nowhere else.
#
# Assertions are off, as in the release builds the fixtures came from.
ARG BASE=debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
ARG WASI=isa-sim/wasi:33.0-48.0.1

FROM ${WASI} AS wasi

# ---------------------------------------------------------------------------
# The source, patched.
# ---------------------------------------------------------------------------
FROM ${BASE} AS source
ARG LLVM_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.0/llvm-project-23.1.0.src.tar.xz
ARG LLVM_SHA256=ab1f0e3ec52448c33e8782eaf0422504b87c7b016b22514653ee0d8fcee479ff
ARG PATCH_SHA256=505bfaa065566cae331025f0bf6bb8161d2fcb4a434152942eae428437b9651e
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl xz-utils patch \
 && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --proto '=https' --tlsv1.2 "${LLVM_URL}" -o /tmp/llvm.tar.xz \
 && echo "${LLVM_SHA256}  /tmp/llvm.tar.xz" | sha256sum --check --strict \
 && mkdir /src && tar -xJf /tmp/llvm.tar.xz -C /src --strip-components=1 \
 && rm /tmp/llvm.tar.xz
COPY clang-wasm/wasi-host-23.1.0.patch /tmp/wasi-host.patch
RUN echo "${PATCH_SHA256}  /tmp/wasi-host.patch" | sha256sum --check --strict \
 && cd /src && patch -p1 --no-backup-if-mismatch < /tmp/wasi-host.patch

# ---------------------------------------------------------------------------
# Native table generators, which the cross build runs on the host.
# ---------------------------------------------------------------------------
FROM ${BASE} AS toolchain
RUN apt-get update \
 && apt-get install -y --no-install-recommends cmake ninja-build python3 g++ \
 && rm -rf /var/lib/apt/lists/*

FROM toolchain AS tblgen
COPY --from=source /src /src
RUN cmake -G Ninja -B /tblgen -S /src/llvm \
      -DCMAKE_BUILD_TYPE=Release \
      -DLLVM_TARGETS_TO_BUILD=WebAssembly \
      -DLLVM_ENABLE_PROJECTS=clang \
      -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF \
      -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_INCLUDE_DOCS=OFF \
      -DCLANG_INCLUDE_TESTS=OFF -DCLANG_BUILD_TOOLS=OFF \
 && cmake --build /tblgen --target llvm-tblgen clang-tblgen llvm-min-tblgen

# ---------------------------------------------------------------------------
# clang, lld and llvm-ar, as one WebAssembly module.
# ---------------------------------------------------------------------------
FROM toolchain AS build
COPY --from=source /src /src
COPY --from=tblgen /tblgen/bin /tblgen/bin
COPY --from=wasi /opt/wasi-sdk /opt/wasi-sdk
COPY clang-wasm/Toolchain-WASI.cmake /Toolchain-WASI.cmake
RUN cmake -G Ninja -B /build -S /src/llvm \
      -DCMAKE_TOOLCHAIN_FILE=/Toolchain-WASI.cmake \
      -DLLVM_NATIVE_TOOL_DIR=/tblgen/bin \
      -DCMAKE_BUILD_TYPE=MinSizeRel \
      -DLLVM_ENABLE_ASSERTIONS=OFF \
      -DLLVM_BUILD_SHARED_LIBS=OFF -DLLVM_ENABLE_PIC=OFF -DLLVM_BUILD_STATIC=ON \
      -DLLVM_ENABLE_THREADS=OFF \
      -DLLVM_ENABLE_ZLIB=OFF -DLLVM_ENABLE_ZSTD=OFF -DLLVM_ENABLE_LIBXML2=OFF \
      -DLLVM_ENABLE_TERMINFO=OFF -DLLVM_ENABLE_LIBEDIT=OFF \
      -DLLVM_BUILD_RUNTIME=OFF -DLLVM_BUILD_TOOLS=OFF -DLLVM_BUILD_UTILS=OFF \
      -DLLVM_INCLUDE_UTILS=OFF -DLLVM_INCLUDE_RUNTIMES=OFF \
      -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_BENCHMARKS=OFF \
      -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_INCLUDE_DOCS=OFF \
      "-DLLVM_TARGETS_TO_BUILD=X86;AArch64;RISCV;Mips;PowerPC;Sparc;WebAssembly" \
      -DLLVM_DEFAULT_TARGET_TRIPLE=riscv64-unknown-linux-musl \
      -DLLVM_FORCE_VC_REPOSITORY=https://github.com/llvm/llvm-project \
      -DLLVM_FORCE_VC_REVISION=ea7d852a70e8bdfaf601d6626a760f9771b2c4b4 \
      -DLLVM_ENABLE_PROJECTS="clang;lld" \
      -DLLVM_TOOL_LLVM_DRIVER_BUILD=ON \
      -DLLVM_TOOL_LLVM_AR_BUILD=ON \
      -DCLANG_ENABLE_ARCMT=OFF -DCLANG_ENABLE_STATIC_ANALYZER=OFF \
      -DCLANG_INCLUDE_TESTS=OFF -DCLANG_BUILD_TOOLS=OFF -DCLANG_INCLUDE_DOCS=OFF \
      -DCLANG_BUILD_EXAMPLES=OFF \
      -DCLANG_LINKS_TO_CREATE="clang" \
      -DLLD_BUILD_TOOLS=OFF \
 && cmake --build /build --target llvm-driver clang-resource-headers -- -k 0 \
 && mkdir -p /out \
 && cp /build/bin/llvm /out/llvm.wasm \
 && cp -r /build/lib/clang/23/include /out/clang-include

FROM scratch
COPY --from=build /out /
