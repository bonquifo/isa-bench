{
  "name": "@isa-sim/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "isa-sim": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "serve": "tsx src/cli.ts serve",
    "cli": "tsx src/cli.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "oxlint src test"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@isa-sim/calibration": "^0.1.0",
    "@isa-sim/contracts": "^0.1.0",
    "fastify": "^5.6.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.5"
  }
}
