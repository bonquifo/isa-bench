# Differential-test fixtures are byte-exact reference output captured from a
# real oracle. Line-ending translation would corrupt them, and on a Windows
# checkout it silently changes what the test suite is comparing against.
src/isa/*/fixtures/** -text

# The guest harnesses are assembled by clang; keep them byte-stable too.
tools/isa/*/harness.S -text

# The WASI patches are checked against a pinned SHA-256 inside the image
# build; a CRLF checkout would fail that check, and patch(1) with it.
tools/isa/clang-wasm/*.patch -text
