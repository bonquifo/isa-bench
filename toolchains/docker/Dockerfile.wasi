ARG BASE=debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
FROM ${BASE} AS fetch
ARG WASI_URL=https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-33/wasi-sdk-33.0-x86_64-linux.tar.gz
ARG WASI_SHA256=0ba8b5bfaeb2adf3f29bab5841d76cf5318ab8e1642ea195f88baba1abd47bce
ARG WASMTIME_URL=https://github.com/bytecodealliance/wasmtime/releases/download/v48.0.1/wasmtime-v48.0.1-x86_64-linux.tar.xz
ARG WASMTIME_SHA256=4c2e31b68ad99e0a519f225a261fda099eb15f056d4a24fdb3c2a46517bde1df
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --proto '=https' --tlsv1.2 "${WASI_URL}" -o /tmp/wasi.tgz \
 && echo "${WASI_SHA256}  /tmp/wasi.tgz" | sha256sum --check --strict \
 && mkdir /opt/wasi-sdk && tar -xzf /tmp/wasi.tgz -C /opt/wasi-sdk --strip-components=1 \
 && curl --fail --location --proto '=https' --tlsv1.2 "${WASMTIME_URL}" -o /tmp/wasmtime.tar.xz \
 && echo "${WASMTIME_SHA256}  /tmp/wasmtime.tar.xz" | sha256sum --check --strict \
 && mkdir /opt/wasmtime && tar -xJf /tmp/wasmtime.tar.xz -C /opt/wasmtime --strip-components=1

FROM ${BASE}
ARG SOURCE_DATE_EPOCH=1787616000
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} PATH=/opt/wasi-sdk/bin:/opt/wasmtime:$PATH ISA_IMAGE_KIND=wasi
LABEL org.opencontainers.image.title="ISA Sim WASI toolchain" \
      org.opencontainers.image.version="33.0-48.0.1" \
      org.opencontainers.image.licenses="Apache-2.0 WITH LLVM-exception"
RUN groupadd --gid 65532 nonroot && useradd --no-log-init --uid 65532 --gid 65532 --home-dir /nonexistent nonroot
COPY --from=fetch /opt/wasi-sdk /opt/wasi-sdk
COPY --from=fetch /opt/wasmtime /opt/wasmtime
COPY toolchains/scripts/self-test.sh /usr/local/bin/isa-self-test
RUN chmod 0555 /usr/local/bin/isa-self-test
USER 65532:65532
WORKDIR /artifacts
ENTRYPOINT ["/usr/local/bin/isa-self-test"]
