{
  "name": "isa-bench",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop ISA simulator: run the same C program across eight instruction-set architectures and compare modeled timing",
  "author": "ISA Bench",
  "type": "module",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:deep": "vitest run --config vitest.deep.config.ts",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.include='src/**' --coverage.exclude='src/**/*.test.*' --coverage.exclude='src/main.tsx' --coverage.exclude='src/**/*.worker.ts' --coverage.exclude='src/isa/*/fixtures/**' --testTimeout=60000",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "desktop:compile": "tsc -b desktop/tsconfig.json --pretty false",
    "desktop:dev": "npm run desktop:compile && concurrently -k -n web,desktop \"vite\" \"electron . --dev\"",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:pack": "npm run desktop:build && node scripts/check-toolchain.mjs && electron-builder --publish never",
    "desktop:pack:win": "npm run desktop:build && node scripts/check-toolchain.mjs && electron-builder --win nsis portable --publish never",
    "desktop:pack:linux": "npm run desktop:build && node scripts/check-toolchain.mjs && electron-builder --linux AppImage tar.gz --publish never",
    "desktop:pack:mac": "npm run desktop:build && node scripts/check-toolchain.mjs && electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "org.isa-bench.workbench",
    "productName": "ISA Bench",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/dist/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/dist/main.js"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ISA Bench",
      "artifactName": "${productName}-Setup-${version}-${os}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${os}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "desktop/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "desktop/icon.png",
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "toolchain",
        "to": "toolchain",
        "filter": [
          "llvm.wasm",
          "mos.wasm",
          "sysroot.tar",
          "manifest.json"
        ]
      }
    ]
  }
}
