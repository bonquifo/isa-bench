{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isa-sim.local/contracts/0.1.0/runner-boundary.schema.json",
  "title": "Signed runner boundary objects",
  "oneOf": [
    { "$ref": "#/$defs/signedIdentity" },
    { "$ref": "#/$defs/signedCapabilities" },
    { "$ref": "#/$defs/signedMeasurementBundle" }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerId", "publicKey", "keyId", "issuedAt"],
      "properties": {
        "runnerId": { "$ref": "#/$defs/id" },
        "publicKey": { "$ref": "#/$defs/base64" },
        "keyId": { "$ref": "#/$defs/id" },
        "issuedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "capabilityTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "reason"],
      "properties": {
        "tier": { "enum": ["execute", "codegen-only", "unsupported"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerId", "observedAt", "expiresAt", "targets", "experiments", "sensors"],
      "properties": {
        "runnerId": { "$ref": "#/$defs/id" },
        "observedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["triple", "abi", "endianness", "addressWidth"],
            "properties": {
              "triple": { "type": "string" },
              "abi": { "type": "string" },
              "endianness": { "enum": ["little", "big"] },
              "addressWidth": { "enum": [16, 32, 64, 128] }
            }
          }
        },
        "experiments": {
          "type": "object",
          "propertyNames": { "enum": ["analytical-inorder", "analytical-ooo", "toolchain-validation", "gem5", "llvm-mca", "champsim", "empirical-measurement", "calibrated-prediction"] },
          "additionalProperties": { "$ref": "#/$defs/capabilityTier" }
        },
        "sensors": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "rawSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleId", "startedAtUnixNs", "durationNs", "iterationCount", "metrics", "perfCounters", "sensorReadings"],
      "properties": {
        "sampleId": { "$ref": "#/$defs/id" },
        "startedAtUnixNs": { "$ref": "#/$defs/decimal" },
        "durationNs": { "$ref": "#/$defs/decimal" },
        "iterationCount": { "$ref": "#/$defs/decimal" },
        "metrics": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "domain", "unit", "value"], "properties": { "name": { "type": "string" }, "domain": { "type": "string" }, "unit": { "type": "string" }, "value": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/decimal" }] } } } },
        "perfCounters": { "type": "array", "items": { "type": "object", "additionalProperties": false } },
        "sensorReadings": { "type": "array", "items": { "type": "object", "additionalProperties": false } }
      }
    },
    "measurementBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "jobId", "runner", "schemaVersion", "adapterVersion", "experimentKind", "inputIdentity", "artifactIdentities", "target", "environment", "sensors", "samples", "createdAt"],
      "properties": {
        "bundleId": { "$ref": "#/$defs/sha256" },
        "jobId": { "$ref": "#/$defs/id" },
        "runner": { "$ref": "#/$defs/identity" },
        "schemaVersion": { "type": "string" },
        "adapterVersion": { "type": "string" },
        "experimentKind": { "const": "empirical-measurement" },
        "inputIdentity": { "$ref": "#/$defs/sha256" },
        "artifactIdentities": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "target": { "type": "object", "additionalProperties": false },
        "environment": { "type": "object", "additionalProperties": false },
        "sensors": { "type": "array", "items": { "type": "object", "additionalProperties": false } },
        "samples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rawSample" } },
        "createdAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "signedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "payload", "signature", "signedAt"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/id" },
        "payload": { "$ref": "#/$defs/identity" },
        "signature": { "$ref": "#/$defs/base64" },
        "signedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "signedCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "payload", "signature", "signedAt"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/id" },
        "payload": { "$ref": "#/$defs/capabilities" },
        "signature": { "$ref": "#/$defs/base64" },
        "signedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "signedMeasurementBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "payload", "signature", "signedAt"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "$ref": "#/$defs/id" },
        "payload": { "$ref": "#/$defs/measurementBundle" },
        "signature": { "$ref": "#/$defs/base64" },
        "signedAt": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
