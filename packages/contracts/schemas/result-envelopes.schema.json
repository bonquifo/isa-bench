{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isa-sim.local/contracts/0.1.0/result-envelopes.schema.json",
  "title": "ISA Sim result envelopes",
  "oneOf": [
    { "$ref": "#/$defs/analyticalOoO" },
    { "$ref": "#/$defs/toolchain" },
    { "$ref": "#/$defs/externalSimulator" },
    { "$ref": "#/$defs/empirical" },
    { "$ref": "#/$defs/calibratedPrediction" }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experimentKind", "modelVersion", "workloadSemanticHash", "artifactPipelineHash", "roiDefinitionHash", "profileConfigFingerprint", "metricDomain", "unit"],
      "properties": {
        "experimentKind": { "enum": ["analytical-inorder", "analytical-ooo", "toolchain-validation", "gem5", "llvm-mca", "champsim", "empirical-measurement", "calibrated-prediction"] },
        "modelVersion": { "$ref": "#/$defs/version" },
        "workloadSemanticHash": { "$ref": "#/$defs/sha256" },
        "artifactPipelineHash": { "$ref": "#/$defs/sha256" },
        "roiDefinitionHash": { "$ref": "#/$defs/sha256" },
        "profileConfigFingerprint": { "$ref": "#/$defs/sha256" },
        "metricDomain": { "enum": ["physical-time-ns", "physical-energy-j", "analytical-model-cycles", "analytical-model-nj", "external-simulator-cycles", "static-throughput-cycles-per-instruction"] },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "domain", "unit", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "domain": { "enum": ["physical-time-ns", "physical-energy-j", "analytical-model-cycles", "analytical-model-nj", "external-simulator-cycles", "static-throughput-cycles-per-instruction"] },
        "unit": { "type": "string", "minLength": 1 },
        "value": { "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }] }
      }
    },
    "common": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "modelVersion", "adapterVersion", "experimentKind", "claimClass", "evidenceClass", "inputIdentity", "artifactIdentities", "comparisonGroupKey", "comparison", "createdAt"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/version" },
        "modelVersion": { "$ref": "#/$defs/version" },
        "adapterVersion": { "$ref": "#/$defs/version" },
        "experimentKind": { "type": "string" },
        "claimClass": { "type": "string" },
        "evidenceClass": { "type": "string" },
        "inputIdentity": { "$ref": "#/$defs/sha256" },
        "artifactIdentities": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "comparisonGroupKey": { "$ref": "#/$defs/sha256" },
        "comparison": { "$ref": "#/$defs/comparison" },
        "createdAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "analyticalOoO": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["metrics", "modelPayload"],
          "properties": {
            "experimentKind": { "const": "analytical-ooo" },
            "claimClass": { "const": "analytical-estimate" },
            "evidenceClass": { "const": "model-output" },
            "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
            "modelPayload": {}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "toolchain": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["target", "build", "validationStatus", "diagnostics"],
          "properties": {
            "experimentKind": { "const": "toolchain-validation" },
            "claimClass": { "const": "functional-toolchain-validation" },
            "evidenceClass": { "const": "generated-code" },
            "target": { "type": "object" },
            "build": { "type": "object" },
            "validationStatus": { "enum": ["passed", "failed", "not-executed"] },
            "diagnostics": { "type": "array", "items": { "type": "string" } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "externalSimulator": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["simulator", "metrics", "rawOutputArtifact"],
          "properties": {
            "experimentKind": { "enum": ["gem5", "llvm-mca", "champsim"] },
            "claimClass": { "enum": ["external-simulation", "static-throughput-estimate"] },
            "evidenceClass": { "const": "external-simulator-output" },
            "simulator": { "type": "object" },
            "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
            "rawOutputArtifact": { "type": "object" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "empirical": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["measurementBundleId", "sampleCount", "metrics"],
          "properties": {
            "experimentKind": { "const": "empirical-measurement" },
            "claimClass": { "const": "empirical-observation" },
            "evidenceClass": { "enum": ["raw-measurement", "aggregated-measurement"] },
            "measurementBundleId": { "$ref": "#/$defs/sha256" },
            "sampleCount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
            "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "calibratedPrediction": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["calibrationId", "metrics", "uncertainty"],
          "properties": {
            "experimentKind": { "const": "calibrated-prediction" },
            "claimClass": { "const": "calibrated-prediction" },
            "evidenceClass": { "const": "calibration-fit" },
            "calibrationId": { "$ref": "#/$defs/sha256" },
            "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
            "uncertainty": { "type": "object" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
