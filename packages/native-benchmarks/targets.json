{
  "schemaVersion": 1,
  "imagesLock": "../../toolchains/images.lock.json",
  "targets": {
    "x86_64-linux": {
      "image": "codegen", "triple": "x86_64-unknown-linux-gnu", "flags": [],
      "linker": "ld.lld", "runtime": "../../toolchains/runtime/x86_64-linux.c",
      "executorImage": "codegen", "executor": ["{binary}"], "tier": "execute"
    },
    "aarch64-linux": {
      "image": "codegen", "triple": "aarch64-unknown-linux-gnu", "flags": [],
      "linker": "ld.lld", "runtime": "../../toolchains/runtime/linux-freestanding.c",
      "executorImage": "qemu", "executor": ["qemu-aarch64", "{binary}"], "tier": "execute"
    },
    "riscv64-linux": {
      "image": "codegen", "triple": "riscv64-unknown-linux-gnu", "flags": ["-march=rv64gc", "-mabi=lp64d"],
      "linker": "ld.lld", "runtime": "../../toolchains/runtime/linux-freestanding.c",
      "executorImage": "qemu", "executor": ["qemu-riscv64", "{binary}"], "tier": "execute"
    },
    "mipsel-o32": {
      "image": "codegen", "triple": "mipsel-unknown-linux-gnu", "flags": ["-march=mips32", "-mabi=o32", "-mno-abicalls", "-fno-pic", "-mno-gpopt"],
      "linker": "ld.lld", "runtime": "../../toolchains/runtime/linux-freestanding.c",
      "executorImage": "qemu", "executor": ["qemu-mipsel", "-strace", "{binary}"], "tier": "execute"
    },
    "powerpc64le-elfv2": {
      "image": "codegen", "triple": "powerpc64le-unknown-linux-gnu", "flags": ["-mabi=elfv2"],
      "linker": "ld.lld", "runtime": "../../toolchains/runtime/linux-freestanding.c",
      "executorImage": "qemu", "executor": ["qemu-ppc64le", "{binary}"], "tier": "execute"
    },
    "sparc-v8": {
      "image": "codegen", "triple": "sparc-unknown-linux-gnu", "flags": ["-mcpu=v8"],
      "linker": "sparc64-linux-gnu-ld -m elf32_sparc", "runtime": "../../toolchains/runtime/linux-freestanding.c",
      "executorImage": "qemu", "executor": ["qemu-sparc", "{binary}"], "tier": "execute",
      "linkImage": "sparc"
    },
    "wasm32-wasip1": {
      "image": "wasi", "triple": "wasm32-wasip1", "flags": [],
      "linker": "wasm-ld", "runtime": "../../toolchains/runtime/host.c",
      "executorImage": "wasi",
      "executor": ["wasmtime", "run", "-C", "cache=n", "-W", "fuel=100000000", "-W", "timeout=10s", "-W", "max-memory-size=67108864", "{binary}"],
      "tier": "execute"
    },
    "mos-sim": {
      "image": "mos", "triple": "mos-sim", "flags": [],
      "linker": "llvm-mos driver", "runtime": "native/mos-runtime.c",
      "executorImage": "mos", "executor": ["mos-sim", "{binary}"], "tier": "execute",
      "smallN": true
    }
  }
}
