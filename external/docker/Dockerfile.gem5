ARG BASE=debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
FROM ${BASE} AS fetch
ARG GEM5_URL=https://codeload.github.com/gem5/gem5/tar.gz/refs/tags/v25.1.0.0
ARG GEM5_SHA256=31381b5b3fce28c0825fbff677c24052fc2c6ad1f2ef2885d54edbafb590ebed
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --proto '=https' --tlsv1.2 "${GEM5_URL}" -o /tmp/gem5.tar.gz \
 && echo "${GEM5_SHA256}  /tmp/gem5.tar.gz" | sha256sum --check --strict \
 && mkdir /src && tar -xzf /tmp/gem5.tar.gz -C /src --strip-components=1

FROM ${BASE} AS build
ARG SOURCE_DATE_EPOCH=1787616000
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} PYTHONHASHSEED=0
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential scons python3-dev pkg-config git \
    libboost-all-dev libprotobuf-dev protobuf-compiler libprotoc-dev \
    libgoogle-perftools-dev libcapstone-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
COPY --from=fetch /src /src
WORKDIR /src
RUN scons build/ALL/gem5.opt -j4 --ignore-style \
    PROTOCOL=MI_example USE_TCMALLOC=True USE_CAPSTONE=True

FROM ${BASE}
ARG SOURCE_DATE_EPOCH=1787616000
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} PYTHONHASHSEED=0 ISA_IMAGE_KIND=gem5
LABEL org.opencontainers.image.title="ISA Sim gem5 O3 syscall-emulation" \
      org.opencontainers.image.version="25.1.0.0" \
      org.opencontainers.image.revision="7a2b0e413d06c5ce7097104abef3b1d9eaabca91" \
      org.opencontainers.image.licenses="BSD-3-Clause"
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 libpython3.11 libboost-regex1.74.0 libprotobuf32 libgoogle-perftools4 libcapstone4 zlib1g \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 65532 nonroot \
 && useradd --no-log-init --uid 65532 --gid 65532 --home-dir /nonexistent nonroot
COPY --from=build /src/build/ALL/gem5.opt /usr/local/bin/gem5.opt
COPY --from=build /src/configs /opt/gem5/configs
COPY external/scripts/external-entrypoint.sh /usr/local/bin/external-entrypoint
RUN chmod 0555 /usr/local/bin/gem5.opt /usr/local/bin/external-entrypoint
USER 65532:65532
WORKDIR /artifacts
ENTRYPOINT ["/usr/local/bin/external-entrypoint"]
